# Secrets for the ai-chase Edge Function.
# Set these on your Supabase project (never commit real values):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Required — your Anthropic API key (kept server-side; never sent to the browser).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — override the Claude model. Defaults to claude-opus-4-8.
# For higher-volume, cost-sensitive chasing you might prefer claude-haiku-4-5.
# CLERA_AI_MODEL=claude-opus-4-8
